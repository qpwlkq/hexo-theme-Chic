.home
  display flex
  flex-direction column
  flex 1

// Preserve the original profile; allow the article list to follow the first screen.
.home-with-posts .profile-container
  flex none
  height auto
  min-height calc(100vh - 4rem)
  min-height calc(100svh - 4rem)
  box-sizing border-box
  padding-top 48px
  padding-bottom 48px

.home-posts
  width calc(100% - 48px)
  max-width 780px
  margin 0 auto 48px

.home-post
  position relative
  display grid
  grid-template-columns 106px minmax(0, 1fr) 20px
  gap 24px
  padding 30px 0 32px
  border-top 1px solid $light-border-color
  .dark-theme &
    border-color #45464a

  h2
    margin 0 0 9px
    font-size 21px
    line-height 1.55
    font-weight 500
    overflow-wrap anywhere
    a::after
      content ''
      position absolute
      inset 0
    a:focus-visible
      outline none

  p
    margin 0
    font-size 15px
    line-height 1.85
    color #73716d
    overflow-wrap anywhere
    .dark-theme &
      color #b2b1ad

  &:focus-within
    outline 2px solid $light-global-link-hover-color
    outline-offset 5px
  &:hover h2 a
    color $light-global-link-hover-color
    .dark-theme &
      color $dark-global-link-hover-color

.home-post-date, .home-post-arrow
  padding-top 5px
  color #73716d
  .dark-theme &
    color #b2b1ad

.home-post-date
  font-size 12px
  font-variant-numeric tabular-nums

@media screen and (max-width: 620px)
  // The mobile main area already reserves 40pt for the fixed navigation.
  .home-with-posts .profile-container
    min-height calc(100vh - 40pt)
    min-height calc(100svh - 40pt)
  .home-posts
    width calc(100% - 40px)
  .home-post
    grid-template-columns minmax(0, 1fr) 20px
    gap 12px
    padding 26px 0
    h2
      font-size 19px
    p
      font-size 14px
  .home-post-copy
    grid-column 1
    grid-row 1
  .home-post-arrow
    grid-column 2
    grid-row 1
  .home-post-date
    grid-column 1
    grid-row 2
    padding-top 0
